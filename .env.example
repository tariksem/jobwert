# Public site URL, e.g. https://jobwert.de
NEXT_PUBLIC_SITE_URL=https://jobwert.pages.dev

# Keep false until domain + legal pages are fully configured.
NEXT_PUBLIC_INDEXABLE=false

# Public legal/provider information used by Impressum and Datenschutz.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_PHONE=

# Optional. Google Analytics is only loaded after explicit consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional monetization links. The premium page is omitted from the sitemap until checkout is configured.
NEXT_PUBLIC_PREMIUM_REPORT_URL=
NEXT_PUBLIC_PREMIUM_REPORT_PRICE=9,90
NEXT_PUBLIC_JOB_PARTNER_URL=
